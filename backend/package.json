{
  "name": "@campuscore/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth-e2e": "vitest run tests/auth.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "db:migrate:audit-test": "tsx scripts/migrateAuditDb.ts",
    "db:provision:audit-scratch": "tsx scripts/provisionAuditScratchDb.ts"
  },
  "dependencies": {
    "@campuscore/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "mysql2": "^3.11.4",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.1"
  }
}
