# CampusCore SMS - Environment Configuration Baseline
NODE_ENV=development
API_PORT=5000
APP_BASE_URL=http://localhost:3000

# MySQL Database Configuration (Local 8.4 LTS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sms_dev
DB_TEST_NAME=sms_test

# Least-privilege Application Account
DB_APP_USER=sms_app
DB_APP_PASSWORD=change_me_to_strong_app_password

# Migrations & DDL Account
DB_MIGRATOR_USER=sms_migrator
DB_MIGRATOR_PASSWORD=change_me_to_strong_migrator_password

# Session & Security
SESSION_SECRET=min_32_characters_random_hex_secret_token_here
STORAGE_DIR=./storage
