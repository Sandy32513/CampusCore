{
  "name": "campuscore-sms",
  "version": "0.0.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "private": true,
  "description": "CampusCore Student Management System",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run build --workspace=shared && npm run typecheck --workspaces --if-present",
    "start:backend": "npm run start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0"
  }
}
